{%- comment -%}
  Pie de página propio (Analia Carolini Belleza). Sustituye al de Dawn por uno
  más simple y 100% en español, editable desde el editor.
{%- endcomment -%}
{{ 'ac-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  .ac-footer { background: {{ section.settings.fondo }}; }
  .ac-footer__brand { font-size: {{ section.settings.marca_size }}px; }
  .ac-footer__grid { padding-top: {{ section.settings.padding_top }}px; }
  .ac-footer__bottom { padding-bottom: {{ section.settings.padding_bottom }}px; }
{% endstyle %}

<footer class="ac-footer ac-section">
  <div class="ac-container">
    <div class="ac-footer__grid">
      <div>
        <a class="ac-footer__brand" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 600 | image_tag: width: section.settings.logo_width, loading: 'lazy', alt: section.settings.marca }}
          {%- else -%}
            {{ section.settings.marca | default: shop.name }}
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline | newline_to_br }}</p>
        {%- endif -%}
        <div class="ac-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".8" fill="currentColor"/></svg></a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.5 2.8 2.3 4.5 5 4.8"/></svg></a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 8H17V4.5h-2.5A4 4 0 0 0 10.5 8.5V11H8v3.5h2.5V21H14v-6.5h2.7l.5-3.5H14V9a1 1 0 0 1 1-1z"/></svg></a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10 9.3l5 2.7-5 2.7z" fill="currentColor"/></svg></a>
          {%- endif -%}
          {%- if section.settings.whatsapp != blank -%}
            <a href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.8A8 8 0 1 1 8 19z"/><path d="M9 9.5c.3 2.3 2.2 4.2 4.5 4.6l1-1.2 1.8.8-.4 1.6c-3.6.3-7.4-3.4-7-7l1.6-.4.8 1.8z"/></svg></a>
          {%- endif -%}
        </div>
      </div>

      <div>
        {%- if section.settings.nav_titulo != blank -%}<h3>{{ section.settings.nav_titulo }}</h3>{%- endif -%}
        <ul>
          {%- for i in (1..6) -%}
            {%- capture k_l %}nav_{{ i }}_texto{% endcapture -%}
            {%- capture k_u %}nav_{{ i }}_url{% endcapture -%}
            {%- if section.settings[k_l] != blank -%}
              <li><a href="{{ section.settings[k_u] | default: '#' }}">{{ section.settings[k_l] }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div>
        {%- if section.settings.sobre_titulo != blank -%}<h3>{{ section.settings.sobre_titulo }}</h3>{%- endif -%}
        {%- if section.settings.sobre_texto != blank -%}<p>{{ section.settings.sobre_texto | newline_to_br }}</p>{%- endif -%}
        {%- if section.settings.email != blank -%}
          <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        {%- endif -%}
      </div>
    </div>

    <div class="ac-footer__bottom">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.marca | default: shop.name }}</span>
        <div class="ac-footer__legal" style="margin-top:8px">
          {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacidad</a>{%- endif -%}
          {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Términos y condiciones</a>{%- endif -%}
          {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Cambios y devoluciones</a>{%- endif -%}
          {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">Envíos</a>{%- endif -%}
          {%- if section.settings.legal_extra_texto != blank -%}<a href="{{ section.settings.legal_extra_url | default: '#' }}">{{ section.settings.legal_extra_texto }}</a>{%- endif -%}
        </div>
      </div>
      {%- if section.settings.mostrar_pagos -%}
        <ul class="ac-footer__pay" aria-label="Medios de pago">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "image_picker", "id": "logo", "label": "Logo (si no hay, se muestra el nombre)" },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 160 },
    { "type": "text", "id": "marca", "label": "Nombre de la marca", "default": "Analia Carolini" },
    { "type": "range", "id": "marca_size", "label": "Tamaño del nombre", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "textarea", "id": "tagline", "label": "Frase de la marca", "default": "Tu momento de spa, en casa." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (con código de país, ej. 5491112345678)" },
    { "type": "paragraph", "content": "Instagram, TikTok, Facebook y YouTube se configuran en Configuración del tema → Redes sociales." },
    { "type": "header", "content": "Navegación" },
    { "type": "text", "id": "nav_titulo", "label": "Título", "default": "Tienda" },
    { "type": "text", "id": "nav_1_texto", "label": "Enlace 1 – texto", "default": "Inicio" },
    { "type": "url", "id": "nav_1_url", "label": "Enlace 1 – destino" },
    { "type": "text", "id": "nav_2_texto", "label": "Enlace 2 – texto" },
    { "type": "url", "id": "nav_2_url", "label": "Enlace 2 – destino" },
    { "type": "text", "id": "nav_3_texto", "label": "Enlace 3 – texto" },
    { "type": "url", "id": "nav_3_url", "label": "Enlace 3 – destino" },
    { "type": "text", "id": "nav_4_texto", "label": "Enlace 4 – texto" },
    { "type": "url", "id": "nav_4_url", "label": "Enlace 4 – destino" },
    { "type": "text", "id": "nav_5_texto", "label": "Enlace 5 – texto" },
    { "type": "url", "id": "nav_5_url", "label": "Enlace 5 – destino" },
    { "type": "text", "id": "nav_6_texto", "label": "Enlace 6 – texto" },
    { "type": "url", "id": "nav_6_url", "label": "Enlace 6 – destino" },
    { "type": "header", "content": "Sobre la marca" },
    { "type": "text", "id": "sobre_titulo", "label": "Título", "default": "Sobre nosotras" },
    { "type": "textarea", "id": "sobre_texto", "label": "Texto" },
    { "type": "text", "id": "email", "label": "Correo de contacto" },
    { "type": "header", "content": "Barra inferior" },
    { "type": "paragraph", "content": "Los enlaces legales aparecen solos cuando completás tus políticas en Configuración → Políticas." },
    { "type": "text", "id": "legal_extra_texto", "label": "Enlace legal extra – texto" },
    { "type": "url", "id": "legal_extra_url", "label": "Enlace legal extra – destino" },
    { "type": "checkbox", "id": "mostrar_pagos", "label": "Mostrar iconos de medios de pago", "default": true },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#2f2b29" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 24 }
  ]
}
{% endschema %}
