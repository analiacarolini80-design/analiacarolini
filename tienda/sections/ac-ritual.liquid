{{ 'ac-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ac-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo }};
  }
  #shopify-section-{{ section.id }} .ac-ritual__text { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .ac-h2 { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .ac-paso .ac-h3 { font-size: {{ section.settings.step_title_size }}px; }
  #shopify-section-{{ section.id }} .ac-body { font-size: {{ section.settings.body_size }}px; }
  #shopify-section-{{ section.id }} .ac-ritual__intro { margin-top: 18px; }
  {%- if section.settings.imagen_derecha -%}
    #shopify-section-{{ section.id }} .ac-ritual__media { order: 2; }
  {%- endif -%}
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .ac-h2 { font-size: {{ section.settings.heading_size | times: 0.75 | round }}px; }
    #shopify-section-{{ section.id }} .ac-ritual__media { order: 0; }
  }
{% endstyle %}

<section class="ac-ritual ac-section">
  <div class="ac-container">
    <div class="ac-ritual__grid">
      <div class="ac-ritual__media">
        <div class="ac-ritual__sticky ac-reveal">
          {%- if section.settings.imagen != blank -%}
            {{ section.settings.imagen | image_url: width: 1400 | image_tag: class: 'ac-ritual__img', loading: 'lazy', widths: '500, 900, 1400', sizes: '(min-width: 990px) 45vw, 100vw' }}
          {%- else -%}
            <img class="ac-ritual__img" src="{{ 'ac-hero-ritual.jpg' | asset_url }}" alt="Mujer relajándose con la máscara LED Renova encendida" width="1024" height="920" loading="lazy">
          {%- endif -%}
        </div>
      </div>
      <div class="ac-ritual__text">
        {%- if section.settings.eyebrow != blank -%}<p class="ac-eyebrow ac-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ac-h2 ac-reveal">{{ section.settings.headline }}</h2>
        {%- if section.settings.intro != blank -%}<p class="ac-body ac-ritual__intro ac-reveal">{{ section.settings.intro | newline_to_br }}</p>{%- endif -%}
        <ol class="ac-pasos">
          {%- for block in section.blocks -%}
            <li class="ac-paso ac-reveal" style="--ac-delay:{{ forloop.index0 | times: 0.06 }}s" {{ block.shopify_attributes }}>
              <span class="ac-paso__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <h3 class="ac-h3">{{ block.settings.titulo }}</h3>
                <p class="ac-body">{{ block.settings.texto | newline_to_br }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.boton_texto != blank -%}
          <a class="ac-btn ac-reveal" style="margin-top:34px" href="{{ section.settings.boton_url | default: '/collections/all' }}">{{ section.settings.boton_texto }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AC – Ritual en pasos",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Tu ritual" },
    { "type": "inline_richtext", "id": "headline", "label": "Título", "default": "15 minutos <em>solo para vos</em>" },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "Mientras leés, mirás una serie o simplemente descansás." },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón (vacío = sin botón)" },
    { "type": "url", "id": "boton_url", "label": "Enlace del botón" },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen" },
    { "type": "checkbox", "id": "imagen_derecha", "label": "Imagen a la derecha", "default": false },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#f7f3ee" },
    { "type": "select", "id": "text_align", "label": "Alineación del texto", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }, { "value": "right", "label": "Derecha" } ], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "step_title_size", "label": "Tamaño del título de cada paso", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 26 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto", "min": 13, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Paso" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Explicá este paso." }
      ]
    }
  ],
  "presets": [ { "name": "AC – Ritual en pasos", "blocks": [ { "type": "paso" }, { "type": "paso" }, { "type": "paso" } ] } ]
}
{% endschema %}
